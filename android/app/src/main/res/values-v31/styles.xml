<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system launch screen before the app draws.
         Navy background and icon circle so it blends into the MaxAI splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/maxai_splash_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/maxai_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
